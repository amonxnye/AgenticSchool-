# --- Local development ---
# Firebase web app config JSON (from the Firebase console: Project settings > Your apps).
# On App Hosting this is provided automatically at build time as FIREBASE_WEBAPP_CONFIG.
NEXT_PUBLIC_FIREBASE_WEBAPP_CONFIG=
# Service-account key for the Admin SDK (Firestore + Auth). Not needed on App Hosting.
GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated addresses allowed into /admin.
ADMIN_EMAILS=
# 32 random bytes, base64: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# --- Model provider fallbacks (used only until settings are saved in /admin/settings) ---
MODEL_PROVIDER=ripa            # ripa | anthropic | mock
RIPA_BASE_URL=https://api.ripaplatform.com/v1
RIPA_MODEL=
RIPA_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
